#!/bin/sh
# commit-msg hook: 拦截提交消息中的过程产物编号引用
# 禁止类别：
#   code review finding 编号（CR-01 / WR-05 / IN-01）
#   决策 ID（D-91-06 / D-84-02 等）
#   phase 编号（Phase 91 / phase 2 等）
#   plan 编号（Plan 03 / plan 3 等）
#   scope 纯数字（refactor(03-01) / feat(02-05) 等）
MSG_FILE="$1"
if grep -qE '(^|[^A-Za-z0-9])(CR|WR|IN)-[0-9]+([^0-9]|$)|D-[0-9]+(\.[0-9]+)?-[0-9]+|(Phase|phase|Plan|plan)[[:space:]]+[0-9]+|\([0-9]+(-[0-9]+)?\)' "$MSG_FILE"; then
    echo "错误：提交消息不得包含过程产物编号引用（如 CR-01 / D-91-06 / Phase 91 / Plan 03 / plan 3 / refactor(03-01)）" >&2
    echo "请在提交消息中描述功能本身，而不是引用编号。" >&2
    exit 1
fi
exit 0
