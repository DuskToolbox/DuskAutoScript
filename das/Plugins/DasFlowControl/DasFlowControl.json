      "95FD2FFA-88F2-4F85-A536-C708D25B641F": {
        "factoryGuid": "2C6DFCFA-F8B6-4272-8F28-1D31738BD0D4",
        "definition": {
          "schemaVersion": 1,
          "kind": "das.flow.launch",
          "label": { "en": "Launch Process", "zh-cn": "启动进程" },
          "componentGuid": "95FD2FFA-88F2-4F85-A536-C708D25B641F",
          "inputs": [
            {
              "id": "signal_in",
              "type": "signal",
              "label": { "en": "Input Signal", "zh-cn": "输入信号" }
            }
          ],
          "outputs": [
            {
              "id": "signal_out",
              "type": "signal",
              "label": { "en": "Output Signal", "zh-cn": "输出信号" }
            }
          ],
          "config": {
            "exePath": {
              "type": "string",
              "label": { "en": "Executable Path", "zh-cn": "可执行文件路径" },
              "required": true
            },
            "args": {
              "type": "string",
              "label": { "en": "Arguments", "zh-cn": "启动参数" }
            },
            "workingDirectory": {
              "type": "string",
              "label": { "en": "Working Directory", "zh-cn": "工作目录" }
            },
            "waitWindowClassRegex": {
              "type": "string",
              "label": { "en": "Wait Window: Class Regex", "zh-cn": "等待窗口：类名正则" },
              "description": {
                "en": "When set, the node blocks after spawning: it keeps polling until exactly one window whose class name matches this regex appears, and only then finishes. Combine with the title regex to require both; leave both regexes empty to skip waiting (spawn success finishes the node). More than one matching window fails the node.",
                "zh-cn": "填写后，节点在启动进程后会阻塞等待：持续轮询系统窗口，直到恰好出现一个类名匹配此正则的窗口才继续执行。可与标题正则同时填写，两者须同时满足；两个正则都留空则不等待，启动成功即完成。匹配到多个窗口会判定节点失败。"
              }
            },
            "waitWindowWindowRegex": {
              "type": "string",
              "label": { "en": "Wait Window: Title Regex", "zh-cn": "等待窗口：标题正则" },
              "description": {
                "en": "When set, the node blocks after spawning: it keeps polling until exactly one window whose title matches this regex appears, and only then finishes. Combine with the class regex to require both; leave both regexes empty to skip waiting. More than one matching window fails the node.",
                "zh-cn": "填写后，节点在启动进程后会阻塞等待：持续轮询系统窗口，直到恰好出现一个标题匹配此正则的窗口才继续执行。可与类名正则同时填写，两者须同时满足；两个正则都留空则不等待，启动成功即完成。匹配到多个窗口会判定节点失败。"
              }
            },
            "waitWindowTimeoutMs": {
              "type": "int",
              "label": { "en": "Wait Window Timeout (ms)", "zh-cn": "等待窗口超时（毫秒）" },
              "description": {
                "en": "Maximum time to wait for the target window before the node fails. Only effective when either wait regex is set; default 30000 ms when omitted, capped at 120000 ms.",
                "zh-cn": "等待目标窗口出现的最长时长，超时则节点判定失败。仅在填写了任一等待正则时生效；留空默认 30000 毫秒，上限 120000 毫秒。"
              }
            },
            "captureOutput": {
              "type": "bool",
              "label": { "en": "Capture Process Output", "zh-cn": "捕获进程输出" },
              "description": {
                "en": "Capture the child process stdout/stderr for failure diagnostics. Does not affect waiting.",
                "zh-cn": "捕获子进程的标准输出/标准错误，供失败诊断使用。不影响节点是否等待。"
              },
              "default": false
            }
          },
          "diagnostics": []
        }
      }
    }
