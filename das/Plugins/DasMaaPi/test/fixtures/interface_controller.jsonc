// Phase 86-05 fixture — PI controller typed-config coverage.
// Exercises:
//   - Win32 typed block (class_regex/window_regex/screencap/mouse/keyboard)
//     + display_short_side/long_side/raw same-level keys.
//   - Gamepad typed block (class_regex/window_regex/gamepad_type/screencap).
//   - Adb controller (existing path, regression guard).
//   - MacOS controller (Tier2 stub target; no typed block on Windows).
// Aligned with MaaFramework/Instance/MaaController.h create signatures and
// MaaFramework/MaaDef.h:348-404 / 449-450 enum tables.
{
  "interface_version": 2,
  "name": "ControllerFixture",
  "version": "2.8.1",
  "controller": [
    {
      "name": "Android",
      "type": "Adb",
      "address": "127.0.0.1:5555"
    },
    {
      "name": "Desktop",
      "type": "Win32",
      "win32": {
        "class_regex": "Arknights.*",
        "window_regex": ".*AutoScript",
        "screencap": "Foreground",
        "mouse": "Seize",
        "keyboard": "SendMessage"
      },
      "display_short_side": 720,
      "display_long_side": 1280,
      "display_raw": false
    },
    {
      "name": "Gamepad1",
      "type": "Gamepad",
      "gamepad": {
        "class_regex": "XboxApp.*",
        "window_regex": ".*",
        "gamepad_type": "DS4",
        "screencap": "GDI"
      }
    },
    {
      "name": "MacStub",
      "type": "MacOS"
    }
  ],
  "resource": [
    {
      "name": "Official",
      "path": ["resource/base"]
    }
  ],
  "task": [
    {
      "name": "DailyFarm",
      "entry": "StartDaily"
    }
  ]
}
