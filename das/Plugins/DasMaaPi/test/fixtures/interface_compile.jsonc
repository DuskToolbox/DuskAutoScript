{
  "interface_version": 2,
  "name": "CompileFixture",
  "version": "1.2.3",
  "controller": [
    {
      "name": "Android",
      "type": "Adb",
      "option": ["controller-mode"]
    }
  ],
  "resource": [
    {
      "name": "Official",
      "path": ["resource"],
      "hash": "hash-expected",
      "option": ["server"]
    }
  ],
  "task": [
    {
      "name": "DailyFarm",
      "entry": "StartDaily",
      "default_check": true,
      "option": ["retry", "medicine", "notify"],
      "pipeline_override": {
        "Stage": {
          "value": "base"
        }
      }
    }
  ],
  "global_option": ["difficulty"],
  // PI v2.8.0 setting[] (D-86-04): each partition references option keys that
  // compile into the global-level pipeline_override merge. "performance"
  // overlaps with global_option (difficulty) — dedup must merge once.
  // "extras" references setting-only options (bonus / filtered-opt) where
  // filtered-opt carries a v2.8.1 controller filter to exercise IsActive.
  "setting": [
    {"name": "performance", "option": ["difficulty", "language"]},
    {"name": "extras", "option": ["bonus", "filtered-opt"]}
  ],
  "option": {
    "difficulty": {
      "type": "select",
      "default_case": ["hard"],
      "cases": [
        {
          "name": "hard",
          "pipeline_override": {
            "Stage": {
              "value": "global-hard"
            }
          }
        }
      ]
    },
    "language": {
      "type": "select",
      "default_case": ["zh"],
      "cases": [
        {"name": "zh", "pipeline_override": {"Language": {"code": "zh"}}},
        {"name": "en", "pipeline_override": {"Language": {"code": "en"}}}
      ]
    },
    "bonus": {
      "type": "select",
      "default_case": ["extra"],
      "cases": [
        {"name": "extra", "pipeline_override": {"Bonus": {"tier": "extra"}}}
      ]
    },
    "filtered-opt": {
      "type": "select",
      "controller": ["MissingController"],
      "cases": [
        {"name": "skip", "pipeline_override": {"Filtered": {"bad": true}}}
      ]
    },
    "server": {
      "type": "switch",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "Server": {
              "value": "official"
            }
          }
        },
        {
          "name": "No"
        }
      ]
    },
    "controller-mode": {
      "type": "select",
      "default_case": ["safe"],
      "cases": [
        {
          "name": "safe",
          "pipeline_override": {
            "Controller": {
              "value": "safe"
            }
          }
        }
      ]
    },
    "retry": {
      "type": "input",
      "inputs": [
        {
          "name": "times",
          "pipeline_type": "int",
          "default": "5"
        }
      ],
      "pipeline_override": {
        "Retry": {
          "times": "{times}"
        }
      }
    },
    "medicine": {
      "type": "checkbox",
      "default_case": ["small"],
      "cases": [
        {
          "name": "small",
          "pipeline_override": {
            "MedicineSmall": {
              "enabled": true
            }
          }
        },
        {
          "name": "large",
          "pipeline_override": {
            "MedicineLarge": {
              "enabled": true
            }
          }
        }
      ]
    },
    "notify": {
      "type": "switch",
      "cases": [
        {
          "name": "yes",
          "pipeline_override": {
            "Notify": {
              "enabled": true
            }
          }
        },
        {
          "name": "no"
        }
      ]
    },
    "inactive": {
      "type": "select",
      "controller": ["MissingController"],
      "cases": [
        {
          "name": "skip",
          "pipeline_override": {
            "Inactive": {
              "bad": true
            }
          }
        }
      ]
    }
  }
}
