import "DasJson.idl";

namespace Das::ExportInterface
{

    // 只读进度更新条目（D-92-06/D-92-07）：承载 SSE 路由 key + authoring document 字段增量。
    // 只提供 Get 方法（只读），不承载 percent/status/stage 语义——显示由 document 字段值决定。
    // 字段增量语义复用 authoring setValue payload（fieldName → IDasJson value），IDL 业务中立。
    [uuid("5C3A9B21-7D4E-4A6C-9D8E-0A1B2C3D4E5F")]
    interface IDasProgressUpdate : IDasBase
    {
        DasResult GetKey([out] IDasReadOnlyString** pp_out_key);
        DasResult GetFieldCount([out] size_t* p_out_count);
        // 越界返回 DAS_E_OUT_OF_RANGE（与 IDasMatchResultImpl 惯例一致）
        DasResult GetFieldByIndex(size_t index, [out] IDasReadOnlyString** pp_out_name, [out] IDasJson** pp_out_value);
    }

    // 反向通知回调（DasMaaPi 实现，D-92-06）：该 key 的所有 SSE 订阅断开时由 service 调用。
    [uuid("9D1E2F34-5A6B-4C7D-8E9F-0F1A2B3C4D5E")]
    interface IDasProgressCallback : IDasBase
    {
        DasResult OnAllSubscribersDisconnected(IDasReadOnlyString* key);
    }

    // 主进程进度服务（DasHttp 实现 + RegisterServiceByName("IDasProgressService") 按名注册，D-92-06）。
    // 跨进程对象参数（IDasProgressCallback* / IDasProgressUpdate*）经 SerializeInInterfaceParam 自动代理化，
    // 无需 RegisterLocalObject + obj_id 手动反向注册。
    // RemoveCallback 必须释放 callback proxy 触发远端释放链，防 DOM 泄漏（RESEARCH Pitfall 3）。
    [uuid("6A4F5E6D-7C8B-4A9D-8E1F-2A3B4C5D6E7F")]
    interface IDasProgressService : IDasBase
    {
        DasResult AddCallback(IDasProgressCallback* callback);
        DasResult RemoveCallback(IDasProgressCallback* callback);
        DasResult Report(IDasProgressUpdate* entry);
    }

}
