import "DasBasicTypes.idl";
import "DasJson.idl";
import "IDasPortMap.idl";
import "IDasTask.idl";
import "IDasTaskComponent.idl";

namespace Das::ExportInterface
{
    [uuid("E8B7A3D1-4F2C-4A1E-9D5B-8C6E7F3A2B1D")] interface IDasGraphRuntime
        : IDasBase
    {
        /// Get last error message (valid for the lifetime of this object).
        DasResult
            GetErrorMessage([out] IDasReadOnlyString * *pp_out_error_message);

        /// Execute a compiled graph plan.
        /// The host for component resolution is bound at construction time.
        DasResult Execute(
            IDasReadOnlyString * p_compiled_artifact_json,
            Das::PluginInterface::IDasStopToken * p_stop_token,
            [out] Das::ExportInterface::IDasJson * *pp_out_result_json);

        /// Execute a compiled graph plan over the typed data plane: graph
        /// inputs ride @p p_graph_inputs as typed entries (keyed by boundary
        /// port id) instead of being patched into sentinel defaults, and
        /// boundary outputs are exported into @p pp_out_outputs as typed
        /// entries — including non-serializable object references that the
        /// JSON result channel can never carry.
        DasResult ExecuteWithTypedIO(
            IDasReadOnlyString * p_compiled_artifact_json,
            Das::PluginInterface::IDasStopToken * p_stop_token,
            Das::ExportInterface::IDasReadOnlyPortMap * p_graph_inputs,
            [out] Das::ExportInterface::IDasPortMap * *pp_out_outputs);

        /// Get the node id that actually finished last in the most recent
        /// run (runtime fact, valid for the lifetime of this object; empty
        /// when no node ever ran). Unlike the plan's executionOrder tail
        /// this reflects gate skips — a skipped tail node never updates it.
        DasResult GetLastExecutedNodeId(
            [out] IDasReadOnlyString * *pp_out_node_id);
    }
}
