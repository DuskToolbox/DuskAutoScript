// DasCoreApi.idl — C ABI 接口（对齐 DasApi.h）
// 生成 DasCoreApi.generated.h，供 C++ 代码使用

// Log level constants for DasSetLogLevel()
defines DasLogLevel{
    DAS_LOG_LEVEL_TRACE = 0,
    DAS_LOG_LEVEL_DEBUG = 1,
    DAS_LOG_LEVEL_INFO = 2,
    DAS_LOG_LEVEL_WARN = 3,
    DAS_LOG_LEVEL_ERROR = 4,
    DAS_LOG_LEVEL_CRITICAL = 5,
    DAS_LOG_LEVEL_OFF = 6,
}

module
{

    //=============================================================================
    // JSON
    //=============================================================================

    [ export, c_abi ] DasResult ParseDasJsonFromString(
        const char*                            p_u8_string,
        [out] Das::ExportInterface::IDasJson** pp_out_json);

    [ export, c_abi ] DasResult
        CreateEmptyDasJson([out] Das::ExportInterface::IDasJson * *pp_out_json);

    //=============================================================================
    // VariantVector
    //=============================================================================

    [ export, c_abi ] DasResult CreateIDasVariantVector(
        [out] Das::ExportInterface::IDasVariantVector * *pp_out_vector);

    //=============================================================================
    // PortMap
    //=============================================================================

    [ export, c_abi ] DasResult CreateIDasPortMap(
        [out] Das::ExportInterface::IDasPortMap * *pp_out_port_map);

    //=============================================================================
    // Logging (U8 string variants)
    //=============================================================================

    [ export, c_abi ] void DasLogInfoU8(const char* p_string);

    [ export, c_abi ] void DasLogWarningU8(const char* p_string);

    [ export, c_abi ] void DasLogErrorU8(const char* p_string);

    [ export, c_abi ] void DasLogDebugU8(const char* p_string);

    //=============================================================================
    // Logging with source location
    //=============================================================================

    [ export, c_abi ] void DasLogDebugU8WithSourceLocation(
        const char*                               p_string,
        Das::ExportInterface::IDasSourceLocation* p_source_location);

    [ export, c_abi ] void DasLogInfoU8WithSourceLocation(
        const char*                               p_string,
        Das::ExportInterface::IDasSourceLocation* p_source_location);

    [ export, c_abi ] void DasLogWarningU8WithSourceLocation(
        const char*                               p_string,
        Das::ExportInterface::IDasSourceLocation* p_source_location);

    [ export, c_abi ] void DasLogErrorU8WithSourceLocation(
        const char*                               p_string,
        Das::ExportInterface::IDasSourceLocation* p_source_location);

    //=============================================================================
    // Error messages
    //=============================================================================

    [ export, c_abi ] DasResult DasGetErrorMessage(
        IDasTypeInfo * p_error_generator,
        DasResult error_code,
        [out] IDasReadOnlyString * *pp_out_error_message);

    [ export, c_abi ] DasResult DasGetPredefinedErrorMessage(
        DasResult error_code,
        [out] IDasReadOnlyString * *pp_out_error_message);

    //=============================================================================
    // Locale
    //=============================================================================

    [ export,
      c_abi ] DasResult DasSetDefaultLocale(IDasReadOnlyString * locale_name);

    [
        export,
        c_abi
    ] DasResult DasGetDefaultLocale([out] IDasReadOnlyString * *pp_out_locale);

    //=============================================================================
    // I18N (string-key translation tables)
    //=============================================================================

    // 从目录装载：扫描 {directory_path}/*.json，文件名 stem 作为 locale 名
    // （en.json → "en"，zh-CN.json → "zh-CN"）。返回只读 IDasI18n 视图。
    [ export, c_abi ] DasResult CreateIDasI18nFromDirectory(
        IDasReadOnlyString*                     directory_path_utf8,
        [out] Das::ExportInterface::IDasI18n**  pp_out_i18n);

    // 从单文件装载：json_file_path 的 stem 作为 locale 名，合并该 locale 的扁平 JSON。
    [ export, c_abi ] DasResult CreateIDasI18nFromFile(
        IDasReadOnlyString*                     json_file_path_utf8,
        [out] Das::ExportInterface::IDasI18n**  pp_out_i18n);

    // 构造空可变 i18n 表，调用方运行时用 AddTranslation / MergeFromFile 填充。
    [ export, c_abi ] DasResult CreateIDasMutableI18n(
        [out] Das::ExportInterface::IDasMutableI18n** pp_out_i18n);

    //=============================================================================
    // Collections
    //=============================================================================

    [ export, c_abi ] DasResult CreateIDasGuidVector(
        const DasGuid*                               p_data,
        size_t                                       size,
        [out] Das::ExportInterface::IDasGuidVector** pp_out_guid);

    [ export, c_abi ] DasResult CreateIDasStringVector(
        [out] Das::ExportInterface::IDasStringVector * *pp_out_vector);

    //=============================================================================
    // Plugin manager
    //=============================================================================

    [ export, c_abi ] DasResult InitializeIDasPluginManager(
        Das::ExportInterface::IDasReadOnlyGuidVector * p_ignore_plugins_guid,
        Das::ExportInterface::IDasInitializeIDasPluginManagerCallback
            * p_on_finished,
        [out] Das::ExportInterface::IDasInitializeIDasPluginManagerWaiter
            * *pp_out_waiter);

    //=============================================================================
    // Memory
    //=============================================================================

    [ export, c_abi ] DasResult CreateIDasMemory(
        size_t                                   size_in_byte,
        [out] Das::ExportInterface::IDasMemory** pp_out_memory);

    //=============================================================================
    // Image
    //=============================================================================

    [ export, c_abi ] DasResult CreateIDasImageFromEncodedData(
        DasImageDesc * p_desc,
        [out] Das::ExportInterface::IDasImage * *pp_out_image);

    [ export, c_abi ] DasResult CreateIDasImageFromDecodedData(
        const DasImageDesc*                     p_desc,
        const DAS::ExportInterface::DasSize*    p_size,
        [out] Das::ExportInterface::IDasImage** pp_out_image);

    [ export, c_abi ] DasResult CreateIDasImageFromRgb888(
        Das::ExportInterface::IDasMemory * p_alias_memory,
        const DAS::ExportInterface::DasSize*    p_size,
        [out] Das::ExportInterface::IDasImage** pp_out_image);

    [ export, c_abi ] DasResult DasPluginLoadImageFromResource(
        IDasTypeInfo * p_type_info,
        IDasReadOnlyString * p_relative_path,
        [out] Das::ExportInterface::IDasImage * *pp_out_image);

    //=============================================================================
    // Error lens
    //=============================================================================

    [ export, c_abi ] DasResult CreateIDasBasicErrorLens(
        [out] Das::PluginInterface::IDasBasicErrorLens * *pp_out_error_lens);

    //=============================================================================
    // Log archive (file-backed, offset cursor)
    //=============================================================================

    // 工厂按 source 枚举分发到 UserJsonl impl（会话目录 user.jsonl）或
    // SpdlogFile impl（g_logger 的 rotating_file_sink_mt 目标文件）。
    // UserJsonl impl 持 session 引用读 user.jsonl 路径；SpdlogFile impl 忽略 session
    // 参数（读 g_logger 的 rotating_file_sink_mt 目标文件）。
    [ export, c_abi ] DasResult CreateIDasLogArchive(
        Das::ExportInterface::DasLogArchiveSource source,
        Das::ExportInterface::IDasLogSession*     session,
        [out] Das::ExportInterface::IDasLogArchive** pp_out_archive);

    // 返回 g_logger 中固定的 DasLogNotifierSink（dynamic_cast sinks vector），
    // 借用引用——调用方持 DasPtr<IDasLogNotifier> 期间 sink 永远有效（g_logger 的
    // shared_ptr 进程级拥有）。返回 null 表示 sink 未装配（早期初始化或单测环境）。
    [ export, c_abi ] DasResult GetDasLogNotifier(
        [out] Das::ExportInterface::IDasLogNotifier** pp_out_notifier);

    //=============================================================================
    // Process log recorder (JSONL user-visible entries)
    //=============================================================================

    [ export, c_abi ] DasResult CreateIDasLogEntry(
        [out] Das::ExportInterface::IDasLogEntry** pp_out_entry);

    // 注入 notifier + session：recorder 写完 user.jsonl 后调 notifier->Signal(UserJsonl)
    // 置 dirty flag；session 提供 user.jsonl 路径、会话目录、图片序号。
    [ export, c_abi ] DasResult CreateIDasProcessLogRecorder(
        Das::ExportInterface::IDasLogNotifier*       notifier,
        Das::ExportInterface::IDasLogSession*        session,
        [out] Das::ExportInterface::IDasProcessLogRecorder** pp_out_recorder);

    //=============================================================================
    // Log session (RAII session directory)
    //=============================================================================

    // 创建会话目录：ctor 建立 {ts}-{pid}/img/ 子目录并清理孤儿会话目录。
    // refcount 归零时（最后一个 DasPtr 释）目录被递归删除。
    [ export, c_abi ] DasResult CreateLogSession(
        IDasReadOnlyString*                          debug_directory,
        [out] Das::ExportInterface::IDasLogSession** pp_out_session);

    //=============================================================================
    // IPC timeout
    //=============================================================================

    [ export, c_abi ] DasResult DasSetIpcTimeout(uint32_t timeout_ms);

    [ export, c_abi ] DasResult
    DasGetIpcTimeout([out] uint32_t* p_out_timeout_ms);

    //=============================================================================
    // Main process interface (C ABI versions)
    //=============================================================================

    [ export, c_abi ] DasResult DasQueryMainProcessInterface(
        const DasGuid&   iid,
        [out] IDasBase** pp_out_object);

    [ export, c_abi ] DasResult DasRegisterMainProcessService(
        IDasBase * p_object,
        const DasGuid& iid);

    [ export, c_abi ] DasResult DasUnregisterMainProcessService(
        const DasGuid& iid);

    [ export, c_abi ] DasResult DasQueryMainProcessInterfaceByName(
        const char*      name,
        [out] IDasBase** pp_out_object);

    [ export, c_abi ] DasResult DasRegisterMainProcessServiceByName(
        IDasBase * p_object,
        const DasGuid& iid,
        const char*    name);

    [ export, c_abi ] DasResult DasUnregisterMainProcessServiceByName(
        const char* name);

    //=============================================================================
    // Log level
    //=============================================================================

    [ export, c_abi ] void DasSetLogLevel(int level);

    //=============================================================================
    // Core services factory
    //=============================================================================

    [ export, c_abi ] DasResult CreateIDasCoreServices(
        IDasReadOnlyString * p_settings_dir,
        IDasReadOnlyString * p_plugin_dir,
        IIpcContext * p_ipc_context,
        [out] IDasCoreServices * *pp_out);

    //=============================================================================
    // GraphRuntime
    //=============================================================================

    [ export, c_abi ] DasResult CreateGraphRuntime(
        [out] Das::ExportInterface::IDasGraphRuntime * *pp_out_runtime);
}
