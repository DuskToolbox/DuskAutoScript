{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://das.local/schemas/task-authoring-http.schema.json",
  "title": "DAS Task Authoring HTTP Contract (Phase 84 strict)",
  "$comment": "Strict Phase 84 authoring wire. additionalProperties:false is the default on every structural object; debugInfo is the sole opaque-object exception. Legacy aliases (kind, properties, migration, sourceFingerprint, sequence, settings, children, applyPreset, addSequenceItem/moveSequenceItem/removeSequenceItem, addNode/removeNode/connectPorts/disconnectPorts/updateNodeConfig, change.op wrapper, {name,label} candidates, string diagnostic code/source, document-level diagnostics) are rejected. Schema and C++ validators in das/Core/TaskScheduler/src/TaskAuthoringContract.cpp must stay in lockstep.",
  "oneOf": [
    { "$ref": "#/$defs/AuthoringGetRequest" },
    { "$ref": "#/$defs/AuthoringApplyRequest" },
    { "$ref": "#/$defs/AuthoringCompileRequest" },
    { "$ref": "#/$defs/AuthoringGetSuccessResponse" },
    { "$ref": "#/$defs/AuthoringApplySuccessResponse" },
    { "$ref": "#/$defs/AuthoringCompileSuccessResponse" },
    { "$ref": "#/$defs/AuthoringErrorResponse" }
  ],
  "$defs": {
    "JsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/JsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JsonValue" }
        }
      ]
    },
    "Endpoint": {
      "type": "object",
      "required": ["method", "path"],
      "additionalProperties": false,
      "properties": {
        "method": { "const": "POST" },
        "path": {
          "type": "string",
          "pattern": "^/api/v1/scheduler/[^/]+/tasks/[0-9]+/authoring/(get|apply|compile)$"
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "required": ["severity", "message"],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "integer",
          "$comment": "Optional DasResult integer code (decimal in logs)."
        },
        "path": {
          "type": "string",
          "$comment": "Opaque provider-authored path string."
        }
      }
    },
    "IconString": {
      "type": "string",
      "pattern": "^(https?://|[A-Za-z]:[\\\\/]|/|\\\\\\\\)",
      "$comment": "Provider-resolved absolute local path (Windows drive, POSIX, or UNC) or http(s) URL. Rejects relative paths, data: URIs, builtin icon names, and resource keys."
    },
    "FieldValidation": {
      "type": "object",
      "required": ["pattern", "message"],
      "additionalProperties": false,
      "properties": {
        "pattern": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "CandidateDescriptor": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "$comment": "Non-null JSON scalar (bool/number/string). Rejects null, object, array.",
          "oneOf": [
            { "type": "boolean" },
            { "type": "number" },
            { "type": "string" }
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/$defs/IconString" }
      }
    },
    "CommandDescriptor": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "icon": { "$ref": "#/$defs/IconString" },
        "confirmation": {
          "type": "string",
          "minLength": 1,
          "$comment": "Only allowed when apply is present (confirmation + openView is rejected)."
        },
        "apply": { "$ref": "#/$defs/CommandApplyTemplate" },
        "openView": { "const": "actionCatalog" },
        "disabled": {
          "type": "boolean",
          "$comment": "D-89-04: 后端状态驱动的命令可用性（如 applyUpdate 无待更新时置灰）。wire 位于命令对象顶层，缺失视为 false。"
        }
      },
      "oneOf": [
        { "required": ["apply"], "not": { "required": ["openView"] } },
        { "required": ["openView"], "not": { "required": ["apply"] } }
      ]
    },
    "CommandApplyTemplate": {
      "type": "object",
      "required": ["kind", "payload"],
      "additionalProperties": false,
      "$comment": "AuthoringChange template without baseRevision; the client injects the current revision at submit time.",
      "properties": {
        "kind": { "$ref": "#/$defs/AuthoringChangeKind" },
        "payload": { "type": "object" }
      }
    },
    "CommandResult": {
      "type": "object",
      "required": ["commandId", "data"],
      "additionalProperties": false,
      "$comment": "D-92-17: invokeCommand 命令业务结果回传，可选（无业务结果的命令不带）；checkUpdate 用它返回 progressKey。",
      "properties": {
        "commandId": { "type": "string", "minLength": 1 },
        "data": { "$ref": "#/$defs/JsonValue" }
      }
    },
    "FieldDescriptor": {
      "type": "object",
      "required": ["name", "label", "valueType", "inputType", "value"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "valueType": {
          "type": "integer",
          "enum": [0, 1, 2, 4, 8, 16, 32],
          "$comment": "0=int 1=uint 2=float 4=string 8=bool 16=jsonObject 32=jsonArray."
        },
        "inputType": {
          "type": "integer",
          "enum": [0, 1, 2, 3, 4, 5, 6, 7, 8],
          "$comment": "0=plain 1=select 2=multiselect 3=long-input 4=region-select 5=filePath 6=directoryPath 7=markdown (readonly, release note/welcome; value may be markdown text or http(s) URL — URL triggers client-side fetch + RFC 7234 cache + markdown render). 8=time (24h \"HH:MM\" string; requires valueType=4)."
        },
        "value": { "$ref": "#/$defs/JsonValue" },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/CandidateDescriptor" },
          "$comment": "Only valid when inputType is select(1) or multiselect(2)."
        },
        "validation": { "$ref": "#/$defs/FieldValidation" },
        "icon": { "$ref": "#/$defs/IconString" },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/CommandDescriptor" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "inputType": { "const": 7 }
            },
            "required": ["inputType"]
          },
          "then": {
            "properties": {
              "readonly": { "const": true }
            },
            "required": ["readonly"]
          },
          "$comment": "inputType==7 (markdown) requires readonly==true (schema side; the C++ validator enforces the same)."
        },
        {
          "if": {
            "properties": {
              "inputType": { "const": 8 }
            },
            "required": ["inputType"]
          },
          "then": {
            "properties": {
              "valueType": { "const": 4 }
            },
            "required": ["valueType"]
          },
          "$comment": "inputType==8 (time) requires valueType==4 (string \"HH:MM\" 24h); the C++ validator enforces the same."
        }
      ]
    },
    "FieldLayoutLeafField": {
      "type": "object",
      "required": ["fieldName"],
      "additionalProperties": false,
      "properties": {
        "fieldName": { "type": "string", "minLength": 1 }
      }
    },
    "FieldLayoutLeafCommand": {
      "type": "object",
      "required": ["commandId"],
      "additionalProperties": false,
      "$comment": "command 作为 fieldLayout 一等控件 — 引用顶层 commands[] 定义池，与 {fieldName} 对称。",
      "properties": {
        "commandId": { "type": "string", "minLength": 1 }
      }
    },
    "FieldLayoutRow": {
      "type": "object",
      "required": ["row"],
      "additionalProperties": false,
      "$comment": "row 横向容器（与 section 纵向容器对称）。只在 section.entries 内合法（FieldLayoutSection.entries.items.oneOf 含本项；FieldLayoutNode oneOf 不含本项，顶层拒绝 rowOutsideSection）。",
      "properties": {
        "row": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/FieldLayoutLeafField" },
              { "$ref": "#/$defs/FieldLayoutLeafCommand" },
              { "$ref": "#/$defs/FieldLayoutRow" }
            ]
          }
        }
      }
    },
    "FieldLayoutSection": {
      "type": "object",
      "required": ["id", "label", "entries"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "icon": { "$ref": "#/$defs/IconString" },
        "defaultExpanded": { "type": "boolean" },
        "entries": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/FieldLayoutLeafField" },
              { "$ref": "#/$defs/FieldLayoutLeafCommand" },
              { "$ref": "#/$defs/FieldLayoutRow" }
            ]
          }
        }
      }
    },
    "FieldLayoutNode": {
      "oneOf": [
        { "$ref": "#/$defs/FieldLayoutLeafField" },
        { "$ref": "#/$defs/FieldLayoutLeafCommand" },
        { "$ref": "#/$defs/FieldLayoutSection" }
      ],
      "$comment": "顶层 layout node 不含 FieldLayoutRow — row 只能在 section.entries 内（validator 拒绝 rowOutsideSection）。"
    },
    "EntryRef": {
      "type": "object",
      "required": ["entryId"],
      "additionalProperties": false,
      "properties": {
        "entryId": { "type": "integer", "minimum": 0 }
      }
    },
    "FieldContainer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/FieldDescriptor" }
        },
        "fieldLayout": {
          "type": "array",
          "items": { "$ref": "#/$defs/FieldLayoutNode" }
        },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/CommandDescriptor" }
        }
      }
    },
    "FormSequenceItem": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "componentGuid": { "type": "string" },
        "targetKind": {
          "type": "string",
          "enum": ["componentRef", "entryRef"]
        },
        "entryRef": { "$ref": "#/$defs/EntryRef" },
        "enabled": { "type": "boolean" },
        "debugInfo": { "type": "object" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/FieldDescriptor" }
        },
        "fieldLayout": {
          "type": "array",
          "items": { "$ref": "#/$defs/FieldLayoutNode" }
        },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/CommandDescriptor" }
        }
      }
    },
    "GraphNode": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "componentGuid": { "type": "string" },
        "targetKind": {
          "type": "string",
          "enum": ["componentRef", "entryRef"]
        },
        "entryRef": { "$ref": "#/$defs/EntryRef" },
        "debugInfo": { "type": "object" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/FieldDescriptor" }
        },
        "fieldLayout": {
          "type": "array",
          "items": { "$ref": "#/$defs/FieldLayoutNode" }
        },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/CommandDescriptor" }
        }
      }
    },
    "FormSequence": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/FormSequenceItem" }
        }
      }
    },
    "GraphDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/GraphNode" }
        }
      }
    },
    "ActionCatalogEntry": {
      "type": "object",
      "required": ["actionId", "label"],
      "additionalProperties": false,
      "properties": {
        "actionId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "icon": { "$ref": "#/$defs/IconString" }
      }
    },
    "ActionCatalogGroup": {
      "type": "object",
      "required": ["id", "label", "actionIds"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "icon": { "$ref": "#/$defs/IconString" },
        "actionIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ActionCatalog": {
      "type": "object",
      "required": ["entries"],
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/ActionCatalogEntry" }
        },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/ActionCatalogGroup" }
        }
      }
    },
    "AuthoringDocument": {
      "type": "object",
      "required": ["contractVersion", "viewKind", "revision"],
      "additionalProperties": false,
      "properties": {
        "contractVersion": { "const": 1 },
        "viewKind": {
          "type": "string",
          "enum": ["formSequence", "graph"]
        },
        "revision": { "type": "integer", "minimum": 0 },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/FieldDescriptor" }
        },
        "fieldLayout": {
          "type": "array",
          "items": { "$ref": "#/$defs/FieldLayoutNode" }
        },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/CommandDescriptor" }
        },
        "formSequence": { "$ref": "#/$defs/FormSequence" },
        "graph": { "$ref": "#/$defs/GraphDocument" },
        "actionCatalog": { "$ref": "#/$defs/ActionCatalog" }
      }
    },
    "AuthoringChangeKind": {
      "type": "string",
      "enum": [
        "setValue",
        "invokeCommand",
        "convertView",
        "addFormSequenceItem",
        "moveFormSequenceItem",
        "removeFormSequenceItem",
        "addGraphNode",
        "removeGraphNode",
        "connectGraphPorts",
        "disconnectGraphPorts",
        "uiEvent"
      ]
    },
    "SetValueTarget": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "document" } }
        },
        {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "formSequenceItem" },
            "id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "graphNode" },
            "id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "AuthoringChangePayload": {
      "oneOf": [
        {
          "type": "object",
          "required": ["target", "fieldName", "value"],
          "additionalProperties": false,
          "properties": {
            "target": { "$ref": "#/$defs/SetValueTarget" },
            "fieldName": { "type": "string", "minLength": 1 },
            "value": { "$ref": "#/$defs/JsonValue" }
          }
        },
        {
          "type": "object",
          "required": ["commandId"],
          "additionalProperties": false,
          "properties": {
            "commandId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["targetViewKind"],
          "additionalProperties": false,
          "properties": {
            "targetViewKind": {
              "type": "string",
              "enum": ["formSequence", "graph"]
            }
          }
        },
        {
          "type": "object",
          "required": ["actionId"],
          "additionalProperties": false,
          "properties": {
            "actionId": { "type": "string", "minLength": 1 },
            "insertionIndex": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["formSequenceItemId", "destinationIndex"],
          "additionalProperties": false,
          "properties": {
            "formSequenceItemId": { "type": "string", "minLength": 1 },
            "destinationIndex": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["formSequenceItemId"],
          "additionalProperties": false,
          "properties": {
            "formSequenceItemId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["actionId"],
          "additionalProperties": false,
          "properties": {
            "actionId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["nodeId"],
          "additionalProperties": false,
          "properties": {
            "nodeId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": [
            "fromNodeId",
            "fromPortId",
            "toNodeId",
            "toPortId"
          ],
          "additionalProperties": false,
          "properties": {
            "fromNodeId": { "type": "string", "minLength": 1 },
            "fromPortId": { "type": "string", "minLength": 1 },
            "toNodeId": { "type": "string", "minLength": 1 },
            "toPortId": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "AuthoringApplyRequest": {
      "type": "object",
      "required": ["baseRevision", "kind", "payload"],
      "additionalProperties": false,
      "$comment": "D-84-01: wire is {baseRevision, kind, payload} directly; no change.op wrapper.",
      "properties": {
        "endpoint": { "$ref": "#/$defs/Endpoint" },
        "baseRevision": { "type": "integer", "minimum": 0 },
        "kind": { "$ref": "#/$defs/AuthoringChangeKind" },
        "payload": { "type": "object" }
      }
    },
    "AuthoringGetRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": { "$ref": "#/$defs/Endpoint" }
      }
    },
    "AuthoringCompileRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": { "$ref": "#/$defs/Endpoint" }
      }
    },
    "HttpSuccessEnvelope": {
      "type": "object",
      "required": ["code", "message", "data"],
      "additionalProperties": false,
      "properties": {
        "code": { "const": 0 },
        "message": { "type": "string" },
        "data": { "$ref": "#/$defs/JsonValue" }
      }
    },
    "AuthoringGetSuccessResponse": {
      "allOf": [
        { "$ref": "#/$defs/HttpSuccessEnvelope" },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "required": ["diagnostics"],
              "additionalProperties": false,
              "properties": {
                "document": { "$ref": "#/$defs/AuthoringDocument" },
                "diagnostics": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/Diagnostic" }
                }
              }
            }
          }
        }
      ]
    },
    "AuthoringApplySuccessResponse": {
      "allOf": [
        { "$ref": "#/$defs/HttpSuccessEnvelope" },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "required": ["acceptedProperties", "document", "diagnostics"],
              "additionalProperties": false,
              "properties": {
                "acceptedProperties": { "$ref": "#/$defs/JsonValue" },
                "document": { "$ref": "#/$defs/AuthoringDocument" },
                "diagnostics": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/Diagnostic" }
                },
                "commandResult": { "$ref": "#/$defs/CommandResult" }
              },
              "$comment": "document.revision must equal baseRevision + 1 (checked by the C++ validator). commandResult is optional (D-92-17); responses without business results omit it."
            }
          }
        }
      ]
    },
    "AuthoringCompileSuccessResponse": {
      "allOf": [
        { "$ref": "#/$defs/HttpSuccessEnvelope" },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "required": ["compile", "diagnostics"],
              "additionalProperties": false,
              "properties": {
                "compile": { "$ref": "#/$defs/JsonValue" },
                "diagnostics": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/Diagnostic" }
                }
              }
            }
          }
        }
      ]
    },
    "AuthoringErrorKind": {
      "type": "string",
      "enum": [
        "taskNotFound",
        "taskUnavailable",
        "capabilityMissing",
        "revisionConflict",
        "authoringValidationFailed",
        "pluginFailure",
        "componentFailure",
        "persistenceFailure",
        "invalidRequest"
      ]
    },
    "AuthoringErrorResponse": {
      "type": "object",
      "required": ["code", "message", "data"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "integer", "not": { "const": 0 } },
        "message": { "type": "string" },
        "data": {
          "type": "object",
          "required": ["errorKind"],
          "additionalProperties": false,
          "properties": {
            "errorKind": { "$ref": "#/$defs/AuthoringErrorKind" },
            "diagnostics": {
              "type": "array",
              "items": { "$ref": "#/$defs/Diagnostic" }
            },
            "baseRevision": { "type": "integer", "minimum": 0 },
            "currentRevision": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
